{
  "hosting": [
    {
      "target": "booking",
      "public": "web",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "marketing/**"],
      "rewrites": [
        { "source": "/join", "destination": "/join.html" },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self' https://getbookking.com https://www.getbookking.com https://getbooking.com https://www.getbooking.com https://test-app-96812.web.app https://test-app-96812-marketing.web.app"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|ico|svg|webp|woff|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "marketing",
      "public": "web/marketing",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        { "source": "/website-builder", "destination": "/templates#how-it-works", "type": 301 },
        { "source": "/website-builder.html", "destination": "/templates#how-it-works", "type": 301 },
        { "source": "/index.html", "destination": "/", "type": 301 },
        { "source": "/templates.html", "destination": "/templates", "type": 301 },
        { "source": "/tap-to-pay.html", "destination": "/tap-to-pay", "type": 301 },
        { "source": "/messaging.html", "destination": "/messaging", "type": 301 },
        { "source": "/contact.html", "destination": "/contact", "type": 301 },
        { "source": "/privacy.html", "destination": "/privacy", "type": 301 },
        { "source": "/terms.html", "destination": "/terms", "type": 301 },
        { "source": "/signup.html", "destination": "/signup", "type": 301 },
        { "source": "/testflight.html", "destination": "/testflight", "type": 301 },
        { "source": "/fishing-charter-software.html", "destination": "/fishing-charter-software", "type": 301 },
        { "source": "/barbershop-software.html", "destination": "/barbershop-software", "type": 301 },
        { "source": "/hair-salon-software.html", "destination": "/hair-salon-software", "type": 301 },
        { "source": "/nail-salon-software.html", "destination": "/nail-salon-software", "type": 301 },
        { "source": "/tattoo-studio-software.html", "destination": "/tattoo-studio-software", "type": 301 },
        { "source": "/personal-trainer-software.html", "destination": "/personal-trainer-software", "type": 301 }
      ],
      "rewrites": [
        { "source": "/testflight", "destination": "/testflight.html" },
        { "source": "/fishing-charter-software", "destination": "/fishing-charter-software.html" },
        { "source": "/personal-trainer-software", "destination": "/personal-trainer-software.html" },
        { "source": "/hair-salon-software", "destination": "/hair-salon-software.html" },
        { "source": "/tattoo-studio-software", "destination": "/tattoo-studio-software.html" },
        { "source": "/barbershop-software", "destination": "/barbershop-software.html" },
        { "source": "/nail-salon-software", "destination": "/nail-salon-software.html" },
        { "source": "/templates", "destination": "/templates.html" },
        { "source": "/tap-to-pay", "destination": "/tap-to-pay.html" },
        { "source": "/messaging", "destination": "/messaging.html" },
        { "source": "/contact", "destination": "/contact.html" },
        { "source": "/privacy", "destination": "/privacy.html" },
        { "source": "/terms", "destination": "/terms.html" },
        { "source": "/signup", "destination": "/signup.html" },
        { "source": "/beta/login", "destination": "/beta/login.html" },
        { "source": "/beta/forgot-password", "destination": "/beta/forgot-password.html" },
        { "source": "/beta/welcome", "destination": "/beta/welcome.html" },
        { "source": "/beta/report-bug", "destination": "/beta/report-bug.html" },
        { "source": "/beta", "destination": "/beta/index.html" },
        { "source": "/admin/login", "destination": "/admin/login.html" },
        { "source": "/admin/forgot-password", "destination": "/admin/forgot-password.html" },
        { "source": "/admin/reset-password", "destination": "/reset-password.html" },
        { "source": "/admin/welcome", "destination": "/admin/welcome.html" },
        { "source": "/admin", "destination": "/admin/requests.html" },
        { "source": "/admin/requests", "destination": "/admin/requests.html" },
        { "source": "/admin/bugs", "destination": "/admin/bugs.html" },
        { "source": "/admin/reports", "destination": "/admin/reports.html" },
        { "source": "/admin/testflight", "destination": "/admin/testflight.html" },
        { "source": "/admin/settings", "destination": "/admin/settings.html" },
        { "source": "/login", "destination": "/login.html" },
        { "source": "/reset-password", "destination": "/reset-password.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "assets/brand/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ],
  "functions": {
    "source": "functions"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
