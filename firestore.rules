rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userTenantIdMatches(tenantId) {
      return isSignedIn()
        && exists(userPath())
        && get(userPath()).data.tenantId == tenantId;
    }

    function isTenantOwnerUid(tenantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
    }

    function canManageTenant(tenantId) {
      return userTenantIdMatches(tenantId) || isTenantOwnerUid(tenantId);
    }

    // Money / access / SMS inventory fields must only change via Admin SDK
    // (Cloud Functions). Client messaging copy remains editable.
    function userProtectedKeysUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'memberSettings',
          'role',
          'accessRole',
          'tenantId',
          'stripeAccountId',
          'stripeTerminalLocationId',
          'smsEnabled',
          'smsStatus',
          'smsPhoneNumber',
          'smsPhoneNumberSid',
          'smsEnabledAt',
          'smsProvisionError',
          'smsSuspendedAt',
          'smsSuspendReason',
          'smsLineIsPaidExtra',
          'smsLineRequestPending',
          'smsLineRequestedAt',
          'smsLineRequestConsentAccepted',
          'smsPaidLinePurchaseAuthorizationId',
          'smsPaidLinePurchaseInvoiceId',
          'smsPaidLinePurchaseAuthorizedAt',
          'smsPaidLinePurchaseExpiresAt',
          'smsMonthlyUsageCount',
          'smsMonthlyUsagePeriod',
          'billingSource',
          'appleAppAccountToken',
          'appleOriginalTransactionId',
          'appleProductId',
          'appleStatus',
          'appleExpiresAt',
          'appleSignedDateMs',
          'subscriptionPlan',
          'subscriptionStatus',
          'stripeCustomerId',
          'stripeSubscriptionId'
        ]);
    }

    // A new profile may only point at a business the signer already owns (the app creates the
    // business first). Teammates are attached by Cloud Functions when they accept an invite.
    // Without this, anyone could create a profile naming another business and read its clients.
    function userCreateIsSafe() {
      let d = request.resource.data;
      return !d.keys().hasAny([
          'memberSettings',
          'role',
          'accessRole',
          'stripeAccountId',
          'stripeTerminalLocationId',
          'stripeCustomerId',
          'billingSource',
          'appleAppAccountToken',
          'appleOriginalTransactionId',
          'appleProductId',
          'appleStatus',
          'appleExpiresAt',
          'appleSignedDateMs',
          'stripeSubscriptionId',
          'smsEnabled',
          'smsStatus',
          'smsPhoneNumber',
          'smsPhoneNumberSid',
          'smsLineIsPaidExtra',
          'smsPaidLinePurchaseAuthorizationId',
          'smsPaidLinePurchaseInvoiceId'
        ])
        && (!('tenantId' in d) || isTenantOwnerUid(d.tenantId))
        && (!('subscriptionStatus' in d) || d.subscriptionStatus == 'trialing');
    }

    // Billing, payout, texting inventory, web address, and domain fields change only through
    // Cloud Functions — never from an app or browser, not even the owner's.
    function tenantServerKeysUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'ownerUid',
          'slug',
          'isDemoAccount',
          'trialStartDate',
          'stripeAccountId',
          'billingSource',
          'appleAppAccountToken',
          'appleOriginalTransactionId',
          'appleProductId',
          'appleStatus',
          'appleExpiresAt',
          'appleSignedDateMs',
          'stripeTerminalLocationId',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'subscriptionPlan',
          'subscriptionStatus',
          'smsEnabled',
          'smsStatus',
          'smsPhoneNumber',
          'smsPhoneNumberSid',
          'smsAreaCode',
          'twilioMessagingServiceSid',
          'twilioSubaccountSid',
          'smsEnabledAt',
          'smsProvisionError',
          'smsSuspendedAt',
          'smsSuspendReason',
          'smsLifetimeNumbersBought',
          'smsExtraLineQuantity',
          'smsLineIsPaidExtra',
          'smsMonthlyUsageCount',
          'smsMonthlyUsagePeriod',
          'smsLastSoloReplacementInvoiceId',
          'smsLastSoloReplacementAt',
          'smsSoloReplacementAuthorizationId',
          'smsSoloReplacementAuthorizationInvoiceId',
          'smsSoloReplacementAuthorizationState',
          'smsSoloReplacementAuthorizationExpiresAt',
          'smsSoloReplacementInFlightAt',
          'customDomain',
          'customDomainWww',
          'customDomainStatus',
          'customDomainSource',
          'customDomainProvider',
          'customDomainOrderId',
          'customDomainNamecheapId',
          'customDomainStripePaymentIntentId',
          'customDomainCustomerPaidUsd',
          'customDomainWholesaleUsd',
          'customDomainAutoRenew'
        ]);
    }

    // Stripe / billing / tax — owner only on the tenant document.
    function tenantMoneyKeysUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'stripeAccountId',
          'stripeTerminalLocationId',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'shopTaxEnabled',
          'inPersonTaxEnabled',
          'subscriptionPlan',
          'subscriptionStatus',
          'ownerUid',
          'smsEnabled',
          'smsStatus',
          'smsPhoneNumber',
          'smsPhoneNumberSid',
          'smsAreaCode',
          'twilioMessagingServiceSid',
          'twilioSubaccountSid',
          'smsEnabledAt',
          'smsProvisionError',
          'smsSuspendedAt',
          'smsSuspendReason',
          'smsLifetimeNumbersBought',
          'smsExtraLineQuantity',
          'smsLineIsPaidExtra',
          'smsMonthlyUsageCount',
          'smsMonthlyUsagePeriod',
          'smsLastSoloReplacementInvoiceId',
          'smsLastSoloReplacementAt',
          'smsSoloReplacementAuthorizationId',
          'smsSoloReplacementAuthorizationInvoiceId',
          'smsSoloReplacementAuthorizationState',
          'smsSoloReplacementAuthorizationExpiresAt',
          'smsSoloReplacementInFlightAt'
        ]);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && userCreateIsSafe();
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && userProtectedKeysUnchanged();
      allow delete: if false;

      // FCM/APNs tokens written by the signed-in client (PushNotificationManager).
      // Parent rules do not cover subcollections — this match is required.
      match /deviceTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /tenantInvites/{inviteId} {
      allow read, write: if false;
    }

    match /betaWaitlist/{entryId} {
      allow read, write: if false;
    }

    match /betaMembers/{memberId} {
      allow read, write: if false;
    }

    match /betaOnboardingTokens/{tokenId} {
      allow read, write: if false;
    }

    match /betaSignupInviteTokens/{tokenId} {
      allow read, write: if false;
    }

    match /betaBugReports/{reportId} {
      allow read, write: if false;
    }

    match /betaReports/{reportId} {
      allow read, write: if false;
    }

    match /platformSettings/{docId} {
      allow read, write: if false;
    }

    // Public host → tenant slug for custom domains (written only by Cloud Functions).
    // Clients should treat this as slug/status lookup only; prefer resolveTenantDomain for CF proxy.
    match /domainMappings/{host} {
      allow read: if true;
      allow write: if false;
    }

    // Booking SPA reads website fields from publicSites/{slug} (Admin SDK projection).
    // Tenant docs stay member/owner-only — Firestore cannot mask Stripe/Twilio fields.
    match /publicSites/{slug} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /tenants/{tenantId} {
      allow read: if userTenantIdMatches(tenantId)
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny([
          'stripeAccountId',
          'stripeTerminalLocationId',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'smsPhoneNumber',
          'smsPhoneNumberSid',
          'twilioMessagingServiceSid',
          'twilioSubaccountSid',
          'billingSource',
          'appleAppAccountToken',
          'appleOriginalTransactionId',
          'appleProductId',
          'appleStatus',
          'appleExpiresAt',
          'appleSignedDateMs',
          'isDemoAccount',
          'trialStartDate',
          'smsEnabled',
          'smsStatus',
          'smsLifetimeNumbersBought',
          'smsExtraLineQuantity',
          'smsLineIsPaidExtra',
          'customDomain',
          'customDomainWww',
          'customDomainStatus'
        ])
        // A new business always starts on a trial; only Stripe (via Cloud Functions) makes it paid.
        && (!('subscriptionStatus' in request.resource.data)
          || request.resource.data.subscriptionStatus == 'trialing');

      // Nobody changes server-managed fields from a client. Owners may change everything else;
      // teammates everything else except the tax switches.
      allow update: if canManageTenant(tenantId)
        && tenantServerKeysUnchanged()
        && (isTenantOwnerUid(tenantId) || tenantMoneyKeysUnchanged());

      allow delete: if isTenantOwnerUid(tenantId);

      match /services/{serviceId} {
        allow read: if true;
        allow write: if canManageTenant(tenantId);
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if canManageTenant(tenantId);
      }

      match /customers/{customerId} {
        allow read, write: if canManageTenant(tenantId);
      }

      match /bookingRequests/{requestId} {
        allow read, write: if canManageTenant(tenantId);
      }

      match /shopOrders/{orderId} {
        allow read, write: if canManageTenant(tenantId);
      }

      // Client texting (log is CF-only; threads allow clientName patches when a customer is saved)
      match /smsThreads/{threadId} {
        allow read: if canManageTenant(tenantId);
        allow create, delete: if false;
        allow update: if canManageTenant(tenantId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clientName', 'updatedAt']);
      }

      match /smsLog/{logId} {
        allow read: if canManageTenant(tenantId);
        allow write: if false;
      }

      match /smsOptOuts/{optId} {
        allow read: if canManageTenant(tenantId);
        allow write: if false;
      }

      // Ledger is Functions-only (settlement / reporting).
      match /paymentLedger/{ledgerId} {
        allow read, write: if false;
      }
    }
  }
}
