# Namecheap sandbox (local Firebase params — gitignored)
# Fill ApiUser + ClientIp, then set the secret with:
#   firebase functions:secrets:set NAMECHEAP_API_KEY --project test-app-96812
#
# ApiUser = sandbox username
# ClientIp = the IPv4 you whitelisted in sandbox API Access
NAMECHEAP_API_USER=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_API_HOST=https://api.sandbox.namecheap.com/xml.response
