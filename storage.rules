rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function userTenantId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    function canWriteTenantTree(tenantId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userTenantId() == tenantId;
    }

    function isSafeImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isSafeAttachmentUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Web booking intake: tenantRefImages/{tenantId}/{authUid}/{filename}
    // Requires Anonymous Auth. uploadId must equal the signed-in uid so callers
    // cannot write into another session's folder (or arbitrary paths).
    match /tenantRefImages/{tenantId}/{uploadId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                  && uploadId == request.auth.uid
                  && firestore.exists(/databases/(default)/documents/tenants/$(tenantId))
                  && isSafeImageUpload()
                  && filename.matches('[a-zA-Z0-9._-]{1,200}');
    }

    match /users/{uid}/profile.jpg {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                  && request.auth.uid == uid
                  && isSafeImageUpload();
    }

    // Writes require image/* on the object (set StorageMetadata.contentType in app SDKs; nil metadata → permission denied).
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                  && isSafeImageUpload()
                  && canWriteTenantTree(tenantId);
    }

    // Beta bug report attachments — uploaders may read/write only their own uid folder.
    // Admins load attachments via download URLs / Admin SDK (not broad Storage list access).
    match /betaBugAttachments/{uid}/{uploadId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                  && request.auth.uid == uid
                  && isSafeAttachmentUpload();
    }
  }
}
